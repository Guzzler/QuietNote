{
  "name": "quietnote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/run-eval.ts",
    "eval:smoke": "tsx scripts/run-eval.ts --limit=5",
    "eval:scripts": "tsx scripts/run-eval.ts --scripts",
    "eval:scripts:all": "tsx scripts/run-eval.ts --scripts --strategy=all",
    "eval:tools": "tsx scripts/run-eval.ts --tools",
    "eval:m1": "tsx scripts/run-m1-baseline.ts"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.2.8",
    "@huggingface/transformers": "^4.0.1",
    "@mediapipe/tasks-genai": "^0.10.29",
    "@mlc-ai/web-llm": "^0.2.80",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "onnxruntime-node": "^1.22.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
